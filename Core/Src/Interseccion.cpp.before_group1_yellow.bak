#include "Interseccion.hpp"

Interseccion::Interseccion(Semaforo& s1, Semaforo& s2, Semaforo& s3, Semaforo& s4, 
    uint32_t tiempoVerde, uint32_t tiempoAmarillo)
    : 
    semaforos_{&s1, &s2, &s3, &s4},
       tiempoVerde(tiempoVerde), tiempoAmarillo(tiempoAmarillo) {}


void Interseccion::ponerTodoEnRojoMenos(int indiceActivo) {

    for (int i = 0; i< 4; i++) {
        if (i != indiceActivo) {
            semaforos_[i]->setColor(ColorSemaforo::ROJO);
        }
    }
}

void Interseccion::faseVerde(int indice ) {
    ponerTodoEnRojoMenos(indice);
    semaforos_[indice]->setColor(ColorSemaforo::VERDE);

    int siguiente = (indice + 1) % 4;
    if (semaforos_[siguiente]->tieneDisplay()) {
        semaforos_[siguiente]->contarRegresivo(9, 1000);
    } else {
        HAL_Delay(tiempoVerde);
    }
}

void Interseccion::faseAmarilla(int indice) {
    ponerTodoEnRojoMenos(indice);
    semaforos_[indice]->setColor(ColorSemaforo::AMARILLO);
    HAL_Delay(tiempoAmarillo);
}

void Interseccion::correrCiclo() {
    
    for (int i = 0; i < 4; i++) {
        faseVerde(i);
        faseAmarilla(i);
    }
}

void Interseccion::run() {
    while (true) {
        correrCiclo();
    }
}
